# Copy to .env and fill in a key.
# Any OpenAI-compatible endpoint works: OpenAI, Groq, OpenRouter, Together, vLLM, LM Studio.
T2SQL_API_KEY=sk-your-key-here

# Optional. Point at a proxy or another provider.
# T2SQL_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to gpt-4o-mini.
# T2SQL_MODEL=gpt-4o-mini
